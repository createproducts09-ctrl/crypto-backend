FLASK_ENV=development
SECRET_KEY=change-me-secret
JWT_SECRET_KEY=change-me-jwt
MONGODB_URI=mongodb://localhost:27017/crypto_research
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
CRYPTOCOMPARE_API_KEY=
# Groq only — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=1
GROQ_MAX_COMPLETION_TOKENS=4096
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=medium
RESEND_API_KEY=
RESEND_FROM="Alphora Labs <noreply@alphoralabs.com>"
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
PORT=5001
# Shared secret for /admin page — send as X-Admin-Key
ADMIN_KEY=change-me-admin-key
# AES-256-GCM payload key (64-char hex). Same value on web/mobile as NEXT_PUBLIC_/EXPO_PUBLIC_API_PAYLOAD_KEY
API_PAYLOAD_KEY=
# Set to 0 to disable response/request payload encryption
API_PAYLOAD_ENCRYPTION=1
# Google Sign-In (Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=
